# ==============================================================================
# Real-Time Stock Market Streaming Platform - Environment Configuration
# ==============================================================================

# Kafka Broker Configuration (Native local KRaft mode, no Docker)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=stock-trades

# Delta Lake Storage Settings
# LOCAL mode: local filesystem path (e.g. ./delta)
# AWS mode: S3 bucket URI (e.g. s3a://my-stock-streaming-bucket/delta)
DELTA_BASE_PATH=./delta

# Spark Checkpoint Base Directory
CHECKPOINT_BASE=./checkpoints

# Spark Streaming Tuning
SPARK_MASTER=local[2]
SPARK_TRIGGER_INTERVAL=5 seconds

# Pipeline Metrics Sink: file | cloudwatch | both (default: file)
METRICS_SINK=file
METRICS_LOG_PATH=./monitoring/metrics.log
CLOUDWATCH_NAMESPACE=StockPipeline

# Testing aid: throttle max offsets per trigger to induce consumer lag (unset = unlimited)
# MAX_OFFSETS_PER_TRIGGER=200

# Warehouse Target: duckdb | redshift
WAREHOUSE_TARGET=duckdb
DUCKDB_PATH=./data/warehouse.duckdb

# AWS Settings (Optional: Uses default boto3 credential chain, no hardcoded keys)
AWS_REGION=us-east-1
REDSHIFT_DATABASE=dev
REDSHIFT_PORT=5439
REDSHIFT_USER=awsuser
REDSHIFT_CLUSTER_IDENTIFIER=stock-cluster
