# ==============================================================================
# Real-Time Stock Market Streaming Platform - Environment Configuration
# ==============================================================================

# Kafka Broker Configuration (Native local KRaft mode, no Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stock-trades

# Spark Streaming Configuration
SPARK_MASTER=local[2]
SPARK_TRIGGER_INTERVAL=5 seconds
SPARK_CHECKPOINT_BASE=./checkpoints

# Storage / Delta Lake Settings
# LOCAL mode: local filesystem directory (e.g. ./data/delta)
# AWS mode: S3 bucket path (e.g. s3a://my-stock-streaming-bucket/delta)
DELTA_BASE_PATH=./data/delta

# Pipeline Metrics Sink: file | cloudwatch | both
METRICS_SINK=file
METRICS_LOG_PATH=./logs/metrics.log
CLOUDWATCH_NAMESPACE=StockMarketStreaming

# Warehouse Target: duckdb | redshift
WAREHOUSE_TARGET=duckdb
DUCKDB_PATH=./data/warehouse.duckdb

# AWS Settings (Optional: Uses default boto3 credential chain, no hardcoded keys)
AWS_REGION=us-east-1
REDSHIFT_DATABASE=dev
REDSHIFT_PORT=5439
REDSHIFT_USER=awsuser
REDSHIFT_CLUSTER_IDENTIFIER=stock-cluster
